# DFIR-Nexus — copy to `.env` in the repo root (or export these in the shell).
# `.env` is gitignored. Leave keys empty unless you want that live provider.
# Golden path (case / ingest / approve / report) does not require any of these.

# --- Examiner / HTTP (required only if you bind serve off loopback) ---
# NEXUS_AUDIT_SECRET=
# NEXUS_PORTAL_PASSWORD=
# NEXUS_BEARER_TOKEN=

# --- LLM pipeline (`nexus pipeline`) — any OpenAI-compatible endpoint ---
# NEXUS_LLM_PROVIDER=openai-compatible
# NEXUS_LLM_MODEL=
# NEXUS_LLM_BASE_URL=
# NEXUS_LLM_API_KEY=
# NEXUS_LLM_REASONING=
# NEXUS_LLM_TIMEOUT=120
# NEXUS_MODE2_TURN_TIMEOUT=900

# --- WP 10.53 context-engineering loop (defaults: Mode 2 steer + Mode 1
#     directions are bounded read-only tool loops; env-overridable) ---
# NEXUS_CONTEXT_LOOP=1
# NEXUS_CONTEXT_LOOP_ROUNDS=8
# NEXUS_CONTEXT_LOOP_CALLS=16
# NEXUS_CONTEXT_LOOP_SECONDS=360
# NEXUS_CONTEXT_LOOP_CALL_CHARS=120000

# --- WP 10.53 full-run scribe: heuristic (default) | signal | llm ---
# NEXUS_FULL_RUN_SCRIBE=heuristic
# NEXUS_FULL_RUN_SCRIBE_MIN_HITS=3

# --- Mode 3 supervised agent runtime (M1-M7) ---
# Follow-up corroboration rounds the supervisor may add (0-24, default 8).
# Each round targets inferred/refuted candidates; the run also stops on
# converged_no_new_evidence or an examiner stop. Per-agent tool budget:
# NEXUS_MODE3_{ROUNDS,CALLS,SECONDS} (default 24/48/1800). The character
# ceiling is the context window (NEXUS_LLM_CONTEXT_WINDOW x fill ratio).
# NEXUS_MODE3_FOLLOWUPS=8
# NEXUS_MODE3_ROUNDS=24
# NEXUS_MODE3_CALLS=48
# NEXUS_MODE3_SECONDS=1800

# --- Optional live threat intel (NEXUS_TI_MOCK=1 forces mock even if keys exist) ---
# NEXUS_TI_MOCK=0
# NEXUS_TI_ABUSECH_API_KEY=
# NEXUS_TI_OTX_API_KEY=
# NEXUS_TI_SHODAN_API_KEY=
# NEXUS_TI_VIRUSTOTAL_API_KEY=
# NEXUS_TI_ABUSEIPDB_API_KEY=
# NEXUS_TI_MISP_URL=
# NEXUS_TI_MISP_API_KEY=
# NEXUS_TI_CROWDSTRIKE_CLIENT_ID=
# NEXUS_TI_CROWDSTRIKE_CLIENT_SECRET=

# --- Optional OpenCTI ---
# OPENCTI_URL=
# OPENCTI_TOKEN=

# --- RAG (Windows examiner MCP is the only RAG HTTP service) ---
# Canonical id — must match the prebuilt Chroma index. Loads from the local
# HuggingFace hub cache when present (~/.cache/huggingface/hub/models--BAAI--bge-base-en-v1.5).
NEXUS_RAG_MODEL=BAAI/bge-base-en-v1.5
# NEXUS_RAG_EMBED_MODEL=   # alias of NEXUS_RAG_MODEL
# NEXUS_RAG_MODEL_REVISION=main
# NEXUS_RAG_RELEASE_REPO=AppliedIR/sift-mcp
# NEXUS_TRIAGE_RELEASE_REPO=AppliedIR/sift-mcp

# --- Dual-host evidence share (Windows owns the KAPE mount; SIFT CIFS-mounts it) ---
# NEXUS_SHARE_ROOT=H:\C
# NEXUS_SIFT_TRIAGE_ROOT=/mnt/windows_mount
# NEXUS_SIFT_EVIDENCE_ROOT=/home/sansforensics/Evidence-files/rocba-500
# NEXUS_SIFT_MEMORY_FILE=/home/sansforensics/Evidence-files/rocba-500/memory/Rocba-Memory.raw


# --- Velociraptor live hunts (Stage 0) — examiner host, not the VR VM ---
# Required on each analysis PC before `nexus collect run` will hunt live.
# Steps (see Docs/SETUP.md §2.6):
# 1. Copy this file to `.env` (gitignored — never commit).
# 2. MCP is HTTP :8002 on the Velociraptor server. Confirm GET /health is ok.
# 3. API key is VR_MCP_API_KEY from the server MCP env (often /etc/velociraptor/mcp.env).
# 4. Leave NEXUS_VR_USE_MOCK unset. Do not set NEXUS_VR_ENDPOINT to gRPC :8001.
# 5. Check (no harvest): nexus collect tools → velociraptor_live: True
# 6. nexus collect run harvests — wait for operator freeze.
# NEXUS_VR_MCP_URL=http://127.0.0.1:8002
# NEXUS_VR_MCP_API_KEY=
# NEXUS_VR_VERIFY_SSL=0
# VELOCIRAPTOR_ENDPOINT=
# VELOCIRAPTOR_API_KEY=
