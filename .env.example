# DFIR-Nexus — copy to `.env` in the repo root (or export these in the shell).
# `.env` is gitignored. Leave keys empty unless you want that live provider.
# Golden path (case / ingest / approve / report) does not require any of these.

# --- Examiner / HTTP (required only if you bind serve off loopback) ---
# NEXUS_AUDIT_SECRET=
# NEXUS_PORTAL_PASSWORD=
# NEXUS_BEARER_TOKEN=

# --- LLM pipeline (`nexus pipeline`) — any OpenAI-compatible endpoint ---
# NEXUS_LLM_PROVIDER=openai-compatible
# NEXUS_LLM_MODEL=
# NEXUS_LLM_BASE_URL=
# NEXUS_LLM_API_KEY=
# NEXUS_LLM_REASONING=

# --- Optional live threat intel (NEXUS_TI_MOCK=1 forces mock even if keys exist) ---
# NEXUS_TI_MOCK=0
# NEXUS_TI_ABUSECH_API_KEY=
# NEXUS_TI_OTX_API_KEY=
# NEXUS_TI_SHODAN_API_KEY=
# NEXUS_TI_VIRUSTOTAL_API_KEY=
# NEXUS_TI_ABUSEIPDB_API_KEY=
# NEXUS_TI_MISP_URL=
# NEXUS_TI_MISP_API_KEY=
# NEXUS_TI_CROWDSTRIKE_CLIENT_ID=
# NEXUS_TI_CROWDSTRIKE_CLIENT_SECRET=

# --- Optional OpenCTI ---
# OPENCTI_URL=
# OPENCTI_TOKEN=

# --- RAG (Windows examiner MCP is the only RAG HTTP service) ---
# Canonical id — must match the prebuilt Chroma index. Loads from the local
# HuggingFace hub cache when present (~/.cache/huggingface/hub/models--BAAI--bge-base-en-v1.5).
NEXUS_RAG_MODEL=BAAI/bge-base-en-v1.5
# NEXUS_RAG_EMBED_MODEL=   # alias of NEXUS_RAG_MODEL
# NEXUS_RAG_MODEL_REVISION=main
# NEXUS_RAG_RELEASE_REPO=AppliedIR/sift-mcp
# NEXUS_TRIAGE_RELEASE_REPO=AppliedIR/sift-mcp

# --- Dual-host evidence share (Windows owns the KAPE mount; SIFT CIFS-mounts it) ---
# NEXUS_SHARE_ROOT=H:\C
# NEXUS_SIFT_TRIAGE_ROOT=/mnt/windows_mount
# NEXUS_SIFT_EVIDENCE_ROOT=/home/sansforensics/Evidence-files/rocba-500
# NEXUS_SIFT_MEMORY_FILE=/home/sansforensics/Evidence-files/rocba-500/memory/Rocba-Memory.raw


# --- Velociraptor (optional second server; mock is default) ---
# NEXUS_VR_USE_MOCK=1
# VELOCIRAPTOR_ENDPOINT=
# VELOCIRAPTOR_API_KEY=
