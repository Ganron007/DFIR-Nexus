# Pinned sources are checked by SHA-256: keep their bytes exactly as exported (D95).
devtools/knowledge/pinned/** -text
# Shell scripts run under bash on Windows too: a CRLF checkout breaks every line ($'\r': command not found).
*.sh text eol=lf
# Verbatim Linux evidence fixtures keep their original line endings on every platform.
tests/fixtures/d514_authlog/** -text
# Hash-verified captured CSV records retain the original evidence bytes (including CRLF).
tests/fixtures/d518_RBCmd_Output.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/d520_m365_clientip.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
