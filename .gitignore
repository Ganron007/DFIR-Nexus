# ── Python ──────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
wheels/
.installed.cfg

# ── Virtual envs ────────────────────────────────────────────────────
.venv/
.ci-venv/
venv/
env/
ENV/

# ── Test / lint / coverage caches ───────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── IDE / editors ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.claude/

# ── OS junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Secrets & local env (never push) ────────────────────────────────
.env
.env.*
!.env.example
secrets.yaml
secrets.json
**/secrets.env
**/secrets.local.*
*.pem
*.key
!*.key.example
# Keep Python modules named secrets.py (e.g. src/nexus/case/secrets.py)
!**/secrets.py

# ── Runtime / case data (lives under ~/.nexus by default) ───────────
.nexus/
# Repo-root only — do not ignore src/nexus/data (knowledge YAML) or Docs/cases (maps)
/cases/
/data/
smoke_test_data/
# Per-run examiner exports (maps + README in Docs/cases stay tracked)
Docs/cases/INC-*/
pipeline.sqlite
nexus-config.json

# Local test USERPROFILE redirects
.testhome/
.home/
.home2/

# ── Large downloaded / generated forensic corpora (NOT source) ──────
# RAG Chroma index + archives (~600 MB when downloaded)
**/rag-index.tar.zst
**/rag-checksums.sha256
**/chroma/
**/.chroma/
chroma.sqlite3

# Triage baselines (~2 GB when downloaded)
**/known_good.db
**/known_good.db.zst
**/context.db
**/context.db.zst
**/registry.db
**/registry.db.zst
**/checksums.sha256
**/triage.db
**/triage/data/

# NSRL / other bulk hash DBs
**/nsrl.sqlite
**/nsrl*.db
**/*nsrl*.zip

# Generic DB / WAL sidecars that appear at runtime
*.sqlite
*.db
*.db-shm
*.db-wal
*.edb

# Compressed release assets if dropped into the tree by mistake
*.tar.zst
*.zst

# HuggingFace / sentence-transformers model caches (if created in-repo)
.cache/
**/torch_cache/
**/huggingface/
**/.hf_cache/
*.gguf
*.onnx
*.safetensors
*.bin
!**/package-lock.bin

# Logs
*.log
*.mcp.lock
# Generated LLM client config (contains lab IPs)
.mcp.json

# ── Build / docs site output ────────────────────────────────────────
_site/
site/

# Local Windows/Linux forensic binaries (downloaded; never commit)
Tools/windows/
Tools/linux/
!Tools/README.md

# ── Scratch ─────────────────────────────────────────────────────────
.session_state.md
*.bak
*.tmp
*.orig
*.swp

# ── Local forensic evidence corpus (never commit samples / EVTX / PCAP / malware) ──
# Entirely local — including README/MANIFEST.
Evidence-files/

# ── Private-repo policy ─────────────────────────────────────────────
# Internal planning / audit / checklist docs are LOCAL ONLY — never published.
Docs/internal/
# Local scratch space (audit scripts, temp renders, working notes).
scratch/
# Claude Code skill bundle — local only while rebranding is in progress.
claude-code/
# Agent/session notes — local only (not part of the public product).
AGENTS.md
.cursor/
